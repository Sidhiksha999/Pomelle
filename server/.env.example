# Copy this file to ".env" (in this same /server folder) and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use. If it is busy, the server falls back to other Flash models.
GEMINI_MODEL=gemini-3.5-flash

# Optional: the port this server listens on (the client expects 8787).
PORT=8787
